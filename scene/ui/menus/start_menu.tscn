focus_neighbor_top = NodePath("../BtnCredits")
focus_neighbor_bottom = NodePath("../BtnStart")
mouse_default_cursor_shape = 2
theme_override_colors/font_hover_color = Color(1, 1, 1, 1)
theme_override_colors/font_pressed_color = Color(0.85, 0.85, 0.85, 1)
theme_override_colors/font_focus_color = Color(1, 1, 1, 1)
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_fonts/font = ExtResource("ext_font")
theme_override_font_sizes/font_size = 32
theme_override_styles/focus = SubResource("StyleBoxEmpty_focus")
theme_override_styles/disabled = SubResource("StyleBoxEmpty_disabled")
theme_override_styles/hover = SubResource("StyleBoxEmpty_hover")
theme_override_styles/pressed = SubResource("StyleBoxEmpty_pressed")
theme_override_styles/normal = SubResource("StyleBoxEmpty_normal")
text = "Exit"

[node name="IrisMask" type="ColorRect" parent="."]
material = SubResource("ShaderMaterial_iris")
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 1)

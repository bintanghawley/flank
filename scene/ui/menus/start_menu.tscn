[sub_resource type="Shader" id="Shader_iris"]
code = "shader_type canvas_item;

uniform vec2 center = vec2(0.697, 0.488);
uniform float radius : hint_range(0.0, 1.5) = 1.45;
uniform float softness : hint_range(0.0, 0.1) = 0.008;

void fragment() {
	vec2 aspect = vec2(SCREEN_PIXEL_SIZE.y / SCREEN_PIXEL_SIZE.x, 1.0);
	vec2 diff = (UV - center) * aspect;
	float dist = length(diff);
	float mask = smoothstep(radius - softness, radius + softness, dist);
	COLOR = vec4(0.0, 0.0, 0.0, mask);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_iris"]
shader = SubResource("Shader_iris")
shader_parameter/center = Vector2(0.697, 0.488)
shader_parameter/radius = 1.45
shader_parameter/softness = 0.008


[sub_resource type="Shader" id="Shader_iris"]
code = "shader_type canvas_item;

uniform vec2 center = vec2(0.5, 0.5);
uniform float radius : hint_range(0.0, 1.6) = 0.0;
uniform float softness : hint_range(0.0, 0.1) = 0.015;

void fragment() {
	vec2 aspect = vec2(SCREEN_PIXEL_SIZE.y / SCREEN_PIXEL_SIZE.x, 1.0);
	vec2 diff = (UV - center) * aspect;
	float dist = length(diff);
	float mask = smoothstep(radius - softness, radius + softness, dist);
	COLOR = vec4(0.0, 0.0, 0.0, mask);
}
"

